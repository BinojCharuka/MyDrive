# ==========================================
# MyCloud Environment Variables
# ==========================================

# 1. Supabase (Free Tier: https://supabase.com)
# Frontend environment variables (prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend service role key (Never expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. Cloudflare R2 (S3-compatible Object Storage - Free Tier: 10GB storage, 10M read req/mo)
# Find in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=mycloud-files
# Optional: custom domain or r2.dev public URL if enabled (default uses signed URLs)
R2_PUBLIC_URL=

# 3. Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# 4. Storage Quotas
# Default quota in bytes (10 GB = 10737418240 bytes)
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
# Max single file upload size (default: 500 MB = 524288000 bytes)
MAX_FILE_SIZE_BYTES=524288000

# 5. Cloudinary Configuration (For Photos, Images & Videos)
# Free tier: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Or CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

